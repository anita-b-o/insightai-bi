PROJECT_NAME=InsightAI BI API
APP_ENV=development
API_V1_PREFIX=/api
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# DATABASE_URL has priority when set. Leave it empty locally to use POSTGRES_*.
DATABASE_URL=
# Optional direct connection used only by Alembic. Keep empty for local PostgreSQL.
DATABASE_DIRECT_URL=
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=insightai
POSTGRES_PASSWORD=insightai
POSTGRES_DB=insightai_bi

# Do not use "*" with allow_credentials=True. Add the final Vercel URL in production.
# Example: BACKEND_CORS_ORIGINS=["https://mi-proyecto.vercel.app"]
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# CSV uploads are transient; PostgreSQL stores imported dataset data.
MAX_UPLOAD_BYTES=10485760
MAX_DATASET_ROWS=50000
MAX_DATASET_COLUMNS=100
MAX_CELL_LENGTH=16384
FEATURE_SELECTION_SAMPLE_ROWS=10000
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=1
DASHBOARD_REFRESH_LOCK_TIMEOUT_SECONDS=300
# Optional locally. Required in Render before the scheduler endpoint can run.
SCHEDULER_SECRET=
# The GitHub workflow evaluates due dashboards every 10 minutes. Health permits
# one interval plus five minutes of delivery/cold-start tolerance.
SCHEDULER_REQUEST_MAX_AGE_SECONDS=300
SCHEDULER_EXPECTED_INTERVAL_SECONDS=600
SCHEDULER_HEARTBEAT_GRACE_SECONDS=300
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

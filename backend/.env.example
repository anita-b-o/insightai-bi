PROJECT_NAME=InsightAI BI API
APP_ENV=development
API_V1_PREFIX=/api
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# DATABASE_URL has priority when set. Leave it empty locally to use POSTGRES_*.
DATABASE_URL=
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=insightai
POSTGRES_PASSWORD=insightai
POSTGRES_DB=insightai_bi

# Do not use "*" with allow_credentials=True. Add the final Vercel URL in production.
# Example: BACKEND_CORS_ORIGINS=["https://mi-proyecto.vercel.app"]
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# Local: storage/datasets. Render with a Persistent Disk mounted at /var/data:
# STORAGE_PATH=/var/data/datasets
STORAGE_PATH=storage/datasets
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=1
DASHBOARD_REFRESH_LOCK_TIMEOUT_SECONDS=300
WORKER_HEARTBEAT_TIMEOUT_SECONDS=180
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

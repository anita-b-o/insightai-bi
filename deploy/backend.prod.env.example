PROJECT_NAME=InsightAI BI API
APP_ENV=production
API_V1_PREFIX=/api
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=insightai
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=insightai_bi
BACKEND_CORS_ORIGINS=["https://app.example.com","https://api.example.com"]
STORAGE_PATH=storage/datasets
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=1
DASHBOARD_REFRESH_LOCK_TIMEOUT_SECONDS=300
WORKER_HEARTBEAT_TIMEOUT_SECONDS=180
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

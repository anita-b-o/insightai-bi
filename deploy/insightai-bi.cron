SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Daily backups at 03:10 UTC
10 3 * * * cd /srv/insightai-bi && COMPOSE_FILE_PATH=docker-compose.prod.yml BACKEND_ENV_FILE=deploy/backend.prod.env ./scripts/backup-db.sh >> /var/log/insightai-bi-backup.log 2>&1
20 3 * * * cd /srv/insightai-bi && COMPOSE_FILE_PATH=docker-compose.prod.yml ./scripts/backup-storage.sh >> /var/log/insightai-bi-backup.log 2>&1
30 3 * * * cd /srv/insightai-bi && ./scripts/prune-backups.sh >> /var/log/insightai-bi-backup.log 2>&1

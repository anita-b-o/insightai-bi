# Local development uses the Docker Compose backend.
# In Vercel, set this to your Render API URL, for example:
# VITE_API_BASE_URL=https://NOMBRE-BACKEND.onrender.com/api
VITE_API_BASE_URL=http://localhost:8000/api
VITE_CLIENT_ERROR_ENDPOINT=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
